---
import Base from '~/layouts/Base.astro';
import Badge from '~/components/site/Badge.astro';
import Btn from '~/components/site/Btn';
import { available, courseHref, isOpen, langOf, lessonKey, program, ui } from '~/data/program';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
---
<Base title={t.curriculum} description={t.curriculumLead}>
	<div class="mx-auto max-w-3xl px-6 py-24 sm:py-32">
		<div class="text-center">
			<h1 class="text-4xl font-medium tracking-tight text-ink">{t.curriculum}</h1>
			<p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-gray-500">{t.curriculumLead}</p>
			<p class="mx-auto mt-4 max-w-2xl text-sm text-gray-400">{t.pilot}</p>
		</div>
		{
			program.map((level) => (
				<section class="mt-28">
					<h2 class="border-b border-line pb-4 text-sm font-medium text-gray-500">
						{t.level} {level.number} · {level.title[lang]}
					</h2>
					<ol class="divide-y divide-line">
						{level.courses.map((course) => {
							const open = isOpen(course);
							const keys = available(course).map((l) => lessonKey(course, l)).join(' ');
							return (
								<li class:list={['flex items-center gap-6 py-8', { 'opacity-50': !open }]} data-progress-keys={open ? keys : undefined} data-done-label={t.done}>
									<Badge number={course.number} soon={!open} />
									<div class="min-w-0 flex-1">
										<h3 class:list={['text-lg font-medium', open ? 'text-gray-800' : 'text-gray-500']}>
											{open ? <a href={courseHref(course, lang)} class="hover:underline">{course.title[lang]}</a> : course.title[lang]}
										</h3>
										<p class="mt-1 text-sm leading-6 text-gray-600">{course.ship[lang]}</p>
										{open && (
											<div class="mt-4 flex items-center gap-3">
												<div class="ha-bar h-1 max-w-40 flex-1 overflow-hidden rounded-full bg-gray-200"><div class="ha-bar-fill h-full w-0 rounded-full bg-accent" /></div>
												<span class="text-xs text-gray-500" data-progress-text />
											</div>
										)}
									</div>
									{open ? (
										<span class="hidden sm:inline-flex"><Btn href={courseHref(course, lang)} label={t.openCourse} kind="outline" /></span>
									) : (
										<span class="hidden text-sm text-gray-400 sm:inline">{t.comingSoon}</span>
									)}
								</li>
							);
						})}
					</ol>
				</section>
			))
		}
		<p class="mt-20 text-center text-sm text-gray-400">{t.progressNote}</p>
	</div>
</Base>
