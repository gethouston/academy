---
// A course summary, like Odin's: badge, title, overview, then sections of lessons.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Badge from '~/components/site/Badge.astro';
import Btn from '~/components/site/Btn';
import Icon from '~/components/site/Icon.astro';
import { available, type Course, langOf, lessonHref, lessonKey, program, sectionsOf, ui } from '~/data/program';
const { course, entry } = Astro.props as { course: Course; entry: CollectionEntry<'courses'> };
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const { Content } = await render(entry);
const level = program.find((l) => l.courses.includes(course));
const lessons = available(course);
const keys = lessons.map((l) => lessonKey(course, l)).join(' ');
---
<Base title={course.title[lang]} description={entry.data.description}>
	<div class="mx-auto max-w-2xl px-6 py-24 sm:py-32">
		<div class="flex flex-col items-center text-center">
			<Badge number={course.number} size="lg" />
			<p class="mt-8 text-sm text-gray-500">{t.level} {level?.number} · {level?.title[lang]} · {t.course} {course.number}</p>
			<h1 class="mt-2 text-4xl font-medium tracking-tight text-ink">{course.title[lang]}</h1>
		</div>

		<h2 class="mt-20 text-lg font-medium text-ink">{t.overview}</h2>
		<div class="lesson-prose prose prose-gray mt-2 max-w-none"><Content /></div>

		<div class="mt-10 flex flex-wrap items-center gap-5" data-progress-keys={keys} data-done-label={t.done}>
			<Btn
				href={lessonHref(course, lessons[0], lang)}
				label={t.start}
				arrow="right"
				data-cta-keys={keys}
				data-hrefs={JSON.stringify(lessons.map((l) => lessonHref(course, l, lang)))}
				data-start={t.start}
				data-continue={t.continue}
				data-review={t.review}
			/>
			<div class="ha-bar h-1 max-w-48 flex-1 overflow-hidden rounded-full bg-gray-200"><div class="ha-bar-fill h-full w-0 rounded-full bg-accent" /></div>
			<span class="text-sm text-gray-500" data-progress-text></span>
		</div>

		<div class="mt-20 space-y-16">
			{
				sectionsOf(course).map((section) => (
					<section>
						<h3 class="border-b border-line pb-4 text-lg font-medium text-ink">{section.title[lang]}</h3>
						<ul class="mt-2">
							{section.lessons.map(({ lesson, index }) => {
								const row = 'flex items-center gap-4 py-3.5 text-[15px]';
								const icon = <Icon name={lesson.kind === 'project' ? 'tools' : 'book'} class="size-5 shrink-0 text-gray-400" />;
								return lesson.slug ? (
									<li data-lesson-key={lessonKey(course, lesson)} class="group">
										<a href={lessonHref(course, lesson, lang)} class:list={[row, 'text-ink hover:opacity-60 transition-opacity']}>
											{icon}
											<span class="flex-1">{lesson.kind === 'project' ? `${t.project}: ` : ''}{lesson.title[lang]}</span>
											{lesson.minutes && <span class="text-xs text-gray-400">{lesson.minutes} {t.minutes}</span>}
											<span class="grid size-6 place-items-center rounded-full border border-gray-200 text-transparent group-[.is-done]:border-[#00a240] group-[.is-done]:bg-[#00a240] group-[.is-done]:text-white">
												<Icon name="check" class="size-3.5" />
											</span>
										</a>
									</li>
								) : (
									<li class:list={[row, 'text-gray-400']}>
										{icon}
										<span class="flex-1">{lesson.title[lang]}</span>
										<span class="text-xs">{t.comingSoon}</span>
									</li>
								);
							})}
						</ul>
					</section>
				))
			}
		</div>
	</div>
</Base>
