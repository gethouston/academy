---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
const { entry } = Astro.props as { entry: CollectionEntry<'pages'> };
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
	<article class="mx-auto max-w-3xl px-4 py-14">
		<h1 class="text-3xl font-semibold text-gray-800">{entry.data.title}</h1>
		<div class="lesson-prose prose prose-gray mt-6"><Content /></div>
	</article>
</Base>
