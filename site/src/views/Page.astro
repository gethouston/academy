---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
const { entry } = Astro.props as { entry: CollectionEntry<'pages'> };
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
	<article class="mx-auto max-w-3xl px-5 py-16 lg:py-24">
		<h1 class="display text-[40px] sm:text-[56px]">{entry.data.title}</h1>
		<div class="lesson-prose prose prose-gray mt-6"><Content /></div>
	</article>
</Base>
