---
import Base from '~/layouts/Base.astro';
import Btn from '~/components/site/Btn';
import Icon from '~/components/site/Icon.astro';
import { allLessons, courseHref, courses, creator, isOpen, langOf, lessonHref, lessonKey, prefixOf, ui } from '~/data/program';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const h = t.home;
const base = prefixOf(lang);
const continueTargets = Object.fromEntries(
	allLessons.map(({ course, lesson }) => [lessonKey(course, lesson), { href: lessonHref(course, lesson, lang), label: `${t.course} ${course.number} · ${lesson.title[lang]}` }]),
);
const icons = ['learn', 'build', 'ship'];
---
<Base title="Houston Academy" description={h.lead} bands>
	<section class="band band-dark -mt-20" data-band="dark" data-theme="dark">
		<div class="mx-auto max-w-3xl px-6 py-28 text-center">
			<h1 class="text-4xl font-medium tracking-tight text-balance sm:text-6xl sm:leading-[1.08]">{h.title[0]} <br class="hidden sm:block" />{h.title[1]}</h1>
			<p class="mx-auto mt-8 max-w-xl text-lg leading-8">{h.lead}</p>
			<div class="mt-12 flex flex-wrap justify-center gap-3">
				<Btn href={`${base}/courses/hello-internet/`} label={t.getStarted} arrow="right" />
				<Btn href={`${base}/curriculum/`} label={h.cta} kind="outline" />
			</div>
			<div class="mt-8" data-continue data-lessons={JSON.stringify(continueTargets)} data-continue-title={t.continueTitle} hidden>
				<a href="#" class="text-sm hover:text-white">
					<span data-continue-title></span> · <span data-continue-label class="underline underline-offset-4"></span>
				</a>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="mx-auto max-w-5xl px-6 py-28 text-center">
			<h2 class="text-3xl font-medium tracking-tight text-ink">{h.how}</h2>
			<p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-gray-500">{h.howLead}</p>
			<div class="mt-24 grid gap-16 sm:grid-cols-3 sm:gap-12">
				{
					h.steps.map((s, i) => (
						<div>
							<Icon name={icons[i]} class="mx-auto size-7 text-ink" />
							<h3 class="mt-6 text-lg font-medium text-ink">{s.title}</h3>
							<p class="mt-3 text-[15px] leading-7 text-gray-500">{s.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="band band-dark" data-band="dark" data-theme="dark">
		<div class="mx-auto max-w-4xl px-6 py-28" data-strip>
			<div class="flex items-center justify-between gap-6">
				<h2 class="text-3xl font-medium tracking-tight">{h.explore}</h2>
				<div class="flex shrink-0 items-center gap-2">
					<span class="mr-2 hidden text-sm tabular-nums sm:inline" data-strip-count aria-live="polite"></span>
					<Btn label={t.prev} kind="outline" arrow="left" iconOnly data-strip-prev />
					<Btn label={t.next} kind="outline" arrow="right" iconOnly data-strip-next />
				</div>
			</div>
			<ol class="course-strip mt-16 flex snap-x snap-mandatory gap-12 overflow-x-auto" data-strip-track tabindex="0" aria-label={h.explore}>
				{
					courses.map((c) => {
						const open = isOpen(c);
						const meta = [c.lessons.length ? `${c.lessons.length} ${t.lessons}` : '', c.duration?.[lang] ?? `${c.hours} h`].filter(Boolean).join(' · ');
						return (
							<li class="flex w-full shrink-0 snap-start flex-col md:w-[calc(50%-1.5rem)]" data-strip-item>
								<p class="text-sm">{t.course} {c.number} · {meta}</p>
								<h3 class="mt-3 text-2xl font-medium tracking-tight">{c.title[lang]}</h3>
								<p class="mt-5 text-[15px] leading-7">{c.summary[lang]}</p>
								<p class="mt-5 flex-1 text-[15px] leading-7"><span class="text-white">{t.youShip}:</span> {c.ship[lang]}</p>
								<div class="mt-8">
									{open ? <Btn href={courseHref(c, lang)} label={t.openCourse} kind="outline" arrow="right" /> : <span class="inline-flex h-9 items-center text-sm text-white/40">{t.comingSoon}</span>}
								</div>
							</li>
						);
					})
				}
			</ol>
			<div class="mt-16">
				<Btn href={`${base}/curriculum/`} label={h.exploreCta} />
			</div>
		</div>
	</section>

	<section class="band">
		<div class="mx-auto max-w-2xl px-6 py-28 text-center">
			<h2 class="text-3xl font-medium tracking-tight text-ink">{h.madeBy}</h2>
			<p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-gray-500">{h.madeByLead}</p>
			<div class="mt-12 flex flex-wrap justify-center gap-3">
				<Btn href={creator.url} label={`${t.follow} ${creator.handle}`} />
				<Btn href="https://github.com/gethouston/academy" label={h.github} kind="outline" />
			</div>
		</div>
	</section>
</Base>
<script>
	// The course strip's arrows. Without this script it still swipes and scrolls.
	document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
		const track = strip.querySelector<HTMLElement>('[data-strip-track]');
		const items = [...strip.querySelectorAll<HTMLElement>('[data-strip-item]')];
		const prev = strip.querySelector<HTMLButtonElement>('[data-strip-prev]');
		const next = strip.querySelector<HTMLButtonElement>('[data-strip-next]');
		const count = strip.querySelector('[data-strip-count]');
		if (!track || !items.length || !prev || !next) return;
		const step = () => items[1].offsetLeft - items[0].offsetLeft;
		const perView = () => Math.max(1, Math.round((track.clientWidth + 1) / step()));
		const setOff = (b: HTMLButtonElement, off: boolean) => {
			b.disabled = off;
			b.toggleAttribute('data-disabled', off);
		};
		const update = () => {
			const first = Math.round(track.scrollLeft / step());
			const shown = perView();
			const last = Math.min(first + shown, items.length) - 1;
			setOff(prev, first <= 0);
			setOff(next, last >= items.length - 1);
			if (count) count.textContent = `${first === last ? first : `${first}–${last}`} / ${items.length - 1}`;
		};
		prev.addEventListener('click', () => track.scrollBy({ left: -step() * perView() }));
		next.addEventListener('click', () => track.scrollBy({ left: step() * perView() }));
		track.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		update();
	});
</script>
