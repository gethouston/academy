---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/site/Icon.astro';
import { allLessons, courseHref, courses, creator, isOpen, langOf, lessonHref, lessonKey, prefixOf, ui } from '~/data/program';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const h = t.home;
const base = prefixOf(lang);
const first = courses[0];
const continueTargets = Object.fromEntries(
	allLessons.map(({ course, lesson }) => [lessonKey(course, lesson), { href: lessonHref(course, lesson, lang), label: `${t.course} ${course.number} · ${lesson.title[lang]}` }]),
);
---
<Base title="Houston Academy" description={h.lead} overlayNav>
	<section class="hero">
		<div class="hero-astro" aria-hidden="true"></div>
		<div class="relative mx-auto flex min-h-[min(100svh,860px)] max-w-3xl flex-col items-center justify-center px-5 pt-28 pb-24 text-center">
			<h1 class="text-[44px] leading-[1.06] font-semibold tracking-[-0.035em] text-white sm:text-[64px]">{h.title[0]}<br />{h.title[1]}</h1>
			<p class="mt-6 max-w-[34rem] text-lg leading-[1.5] text-white/70 sm:text-[19px]">{h.lead}</p>
			<div class="mt-9 flex flex-wrap justify-center gap-3">
				<a href={`${base}/courses/hello-internet/`} class="btn btn-white">{t.getStarted}</a>
				<a href={`${base}/curriculum/`} class="btn btn-ghost">{h.cta}</a>
			</div>
			<div class="mt-6" data-continue data-lessons={JSON.stringify(continueTargets)} data-continue-title={t.continueTitle} hidden>
				<a href="#" class="text-[15px] text-white/60 hover:text-white">
					<span data-continue-title></span> · <span data-continue-label></span> ›
				</a>
			</div>
		</div>
	</section>

	<section class="mx-auto grid max-w-[1120px] items-center gap-14 px-5 py-20 md:grid-cols-2 lg:px-[52px] lg:py-[104px]">
		<div>
			<h2 class="text-[34px] leading-[1.2] font-[340] tracking-[-0.015em] text-gray-500">{h.statement[0]}</h2>
			<p class="mt-5 text-[34px] leading-[1.2] font-normal tracking-[-0.015em] text-ink-strong">{h.statement[1]}</p>
		</div>
		<a href={courseHref(first, lang)} class="block rounded-3xl bg-white p-7 shadow-[0_24px_64px_-24px_rgba(0,0,0,0.22)] ring-1 ring-black/[0.09] transition hover:ring-black/20">
			<p class="text-sm text-gray-500">{h.firstCourse} · {t.course} {first.number}</p>
			<p class="mt-1 text-xl font-medium text-ink-strong">{first.title[lang]}</p>
			<ul class="mt-5 space-y-2.5">
				{first.lessons.map((l) => <li class="flex items-center gap-3 rounded-xl px-4 py-3.5 text-[15px] ring-1 ring-black/[0.09]"><Icon name={l.kind === 'project' ? 'tools' : 'book'} class="size-5 text-gray-500" /><span class="flex-1">{l.title[lang]}</span><span class="text-xs text-gray-500">{l.minutes} {t.minutes}</span></li>)}
			</ul>
		</a>
	</section>

	<section class="mx-auto max-w-[1120px] px-5 pb-20 lg:px-[52px] lg:pb-[104px]">
		<h2 class="display text-[40px] sm:text-[56px]">{h.how}</h2>
		<p class="mt-5 max-w-2xl text-lg leading-[1.55] text-gray-600">{h.howLead}</p>
		<div class="mt-12 grid gap-8 sm:grid-cols-3">
			{
				h.steps.map((s) => (
					<div class="border-t border-black/[0.16] pt-5">
						<h3 class="text-[23px] font-medium tracking-[-0.02em] text-ink-strong">{s.title}</h3>
						<p class="mt-2 text-[15px] leading-[1.6] text-gray-600">{s.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="on-dark bg-band">
		<div class="mx-auto max-w-[1120px] px-5 py-20 text-center lg:px-[52px] lg:py-[104px]">
			<h2 class="display text-[40px] sm:text-[56px]">{h.explore}</h2>
			<div class="mt-12 grid grid-cols-2 gap-3 text-left md:grid-cols-3 lg:grid-cols-4">
				{
					courses.map((c) => {
						const open = isOpen(c);
						const card = 'flex min-h-40 flex-col justify-between rounded-2xl p-5 ring-1';
						const inner = (
							<>
								<span class:list={['text-[40px] leading-none font-[340] tracking-[-0.03em]', open ? 'text-white' : 'text-white/30']}>{c.number}</span>
								<span>
									<span class:list={['block text-[15px] leading-snug font-medium', open ? 'text-white' : 'text-white/45']}>{c.title[lang]}</span>
									{!open && <span class="mt-1 block text-xs text-white/35">{t.comingSoon}</span>}
								</span>
							</>
						);
						return open ? <a href={courseHref(c, lang)} class:list={[card, 'bg-white/[0.07] ring-white/15 transition hover:bg-white/[0.12]']}>{inner}</a> : <div class:list={[card, 'ring-white/[0.08]']}>{inner}</div>;
					})
				}
			</div>
			<a href={`${base}/curriculum/`} class="btn btn-white mt-12">{h.exploreCta}</a>
		</div>
	</section>

	<section class="mx-auto max-w-2xl px-5 py-20 text-center lg:py-[104px]">
		<h2 class="display text-[40px] sm:text-[56px]">{h.madeBy}</h2>
		<p class="mx-auto mt-5 max-w-lg text-lg leading-[1.55] text-gray-600">{h.madeByLead}</p>
		<p class="mt-7 inline-flex items-center gap-3 text-[15px] text-gray-600">
			<img src="/img/julian-96.webp" alt="" width="40" height="40" class="size-10 rounded-full" />
			<span>{t.createdBy} <a href={creator.url} class="font-medium text-ink-strong underline underline-offset-2">{creator.name}</a></span>
		</p>
		<div class="mt-7 flex flex-wrap justify-center gap-3">
			<a href={creator.url} class="btn btn-primary"><Icon name="x" class="size-4" /> {t.follow} {creator.handle}</a>
			<a href="https://github.com/gethouston/academy" class="btn btn-outline"><Icon name="github" class="size-[18px]" /> {h.github}</a>
		</div>
	</section>
</Base>
