---
import Base from '~/layouts/Base.astro';
import Badge from '~/components/site/Badge.astro';
import Btn from '~/components/site/Btn';
import Icon from '~/components/site/Icon.astro';
import { allLessons, courseHref, courses, creator, isOpen, langOf, lessonHref, lessonKey, prefixOf, ui } from '~/data/program';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const h = t.home;
const base = prefixOf(lang);
const continueTargets = Object.fromEntries(
	allLessons.map(({ course, lesson }) => [lessonKey(course, lesson), { href: lessonHref(course, lesson, lang), label: `${t.course} ${course.number} · ${lesson.title[lang]}` }]),
);
const icons = ['learn', 'build', 'ship'];
---
<Base title="Houston Academy" description={h.lead}>
	<section class="mx-auto max-w-3xl px-6 pt-32 pb-40 text-center sm:pt-44 sm:pb-52">
		<h1 class="text-4xl font-medium tracking-tight text-balance text-ink sm:text-6xl sm:leading-[1.08]">{h.title[0]} <br class="hidden sm:block" />{h.title[1]}</h1>
		<p class="mx-auto mt-8 max-w-xl text-lg leading-8 text-gray-500">{h.lead}</p>
		<div class="mt-12 flex flex-wrap justify-center gap-3">
			<Btn href={`${base}/courses/hello-internet/`} label={t.getStarted} arrow="right" />
			<Btn href={`${base}/curriculum/`} label={h.cta} kind="outline" />
		</div>
		<div class="mt-8" data-continue data-lessons={JSON.stringify(continueTargets)} data-continue-title={t.continueTitle} hidden>
			<a href="#" class="text-sm text-gray-500 hover:text-ink">
				<span data-continue-title></span> · <span data-continue-label class="underline underline-offset-4"></span>
			</a>
		</div>
	</section>

	<section class="border-t border-line">
		<div class="mx-auto max-w-5xl px-6 py-32 text-center sm:py-44">
			<h2 class="text-3xl font-medium tracking-tight text-ink">{h.how}</h2>
			<p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-gray-500">{h.howLead}</p>
			<div class="mt-24 grid gap-16 sm:grid-cols-3 sm:gap-12">
				{
					h.steps.map((s, i) => (
						<div>
							<Icon name={icons[i]} class="mx-auto size-7 text-ink" />
							<h3 class="mt-6 text-lg font-medium text-ink">{s.title}</h3>
							<p class="mt-3 text-[15px] leading-7 text-gray-500">{s.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-t border-line">
		<div class="mx-auto max-w-4xl px-6 py-32 text-center sm:py-44">
			<h2 class="text-3xl font-medium tracking-tight text-ink">{h.explore}</h2>
			<div class="mt-24 grid grid-cols-2 gap-x-6 gap-y-16 sm:grid-cols-3 lg:grid-cols-4">
				{
					courses.map((c) => {
						const open = isOpen(c);
						const inner = (
							<>
								<Badge number={c.number} soon={!open} />
								<span class:list={['text-[15px] leading-snug', open ? 'text-ink' : 'text-gray-400']}>{c.title[lang]}</span>
							</>
						);
						const card = 'flex flex-col items-center gap-4';
						return open ? <a href={courseHref(c, lang)} class:list={[card, 'hover:opacity-60 transition-opacity']}>{inner}</a> : <div class={card}>{inner}</div>;
					})
				}
			</div>
			<div class="mt-24">
				<Btn href={`${base}/curriculum/`} label={h.exploreCta} kind="outline" />
			</div>
		</div>
	</section>

	<section class="border-t border-line">
		<div class="mx-auto max-w-2xl px-6 py-32 text-center sm:py-44">
			<h2 class="text-3xl font-medium tracking-tight text-ink">{h.madeBy}</h2>
			<p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-gray-500">{h.madeByLead}</p>
			<div class="mt-12 flex flex-wrap justify-center gap-3">
				<Btn href={creator.url} label={`${t.follow} ${creator.handle}`} />
				<Btn href="https://github.com/gethouston/academy" label={h.github} kind="outline" />
			</div>
		</div>
	</section>
</Base>
