---
// A lesson, like Odin's: course lessons on the left, the text in a narrow column,
// "Lesson contents" on the right, and Mark complete / Next at the bottom.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Btn from '~/components/site/Btn';
import Icon from '~/components/site/Icon.astro';
import { allLessons, type Course, courseHref, type Lesson, langOf, lessonHref, lessonKey, sectionsOf, ui } from '~/data/program';
const { course, lesson, entry } = Astro.props as { course: Course; lesson: Lesson; entry: CollectionEntry<'courses'> };
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const { Content, headings } = await render(entry);
const contents = headings.filter((h) => h.depth === 2);
const at = allLessons.findIndex((x) => x.course === course && x.lesson === lesson);
const prev = allLessons[at - 1];
const next = allLessons[at + 1];
const key = lessonKey(course, lesson);
const index = course.lessons.indexOf(lesson);
---
<Base title={entry.data.title} description={entry.data.description}>
	<div class="mx-auto flex max-w-7xl gap-16 px-6 lg:px-10">
		<aside class="hidden w-52 shrink-0 py-24 sm:py-32 lg:block">
			<div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto">
				<a href={courseHref(course, lang)} class="flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-800"><Icon name="left" class="size-4" /> {t.backToCourse}</a>
				<p class="mt-4 font-medium text-ink">{course.title[lang]}</p>
				<nav class="mt-6 space-y-5 text-sm">
					{
						sectionsOf(course).map((section) => (
							<details open={section.lessons.some((l) => l.lesson === lesson)} class="group/section">
								<summary class="flex cursor-pointer list-none items-center justify-between py-1 font-medium text-gray-700">
									{section.title[lang]}
									<Icon name="chevron" class="size-4 text-gray-400 transition group-open/section:rotate-180" />
								</summary>
								<ul class="mt-2 space-y-1">
									{section.lessons.map(({ lesson: l }) =>
										l.slug ? (
											<li data-lesson-key={lessonKey(course, l)} class="group">
												<a href={lessonHref(course, l, lang)} aria-current={l === lesson ? 'page' : undefined} class:list={['flex items-center gap-2 py-1.5', l === lesson ? 'font-medium text-ink' : 'text-gray-500 hover:text-ink']}>
													<Icon name={l.kind === 'project' ? 'tools' : 'book'} class="size-4 shrink-0 text-gray-400 group-[.is-done]:hidden" />
													<Icon name="check" class="hidden size-4 shrink-0 text-[#00a240] group-[.is-done]:block" />
													{l.title[lang]}
												</a>
											</li>
										) : (
											<li class="flex items-center gap-2 py-1.5 text-gray-400"><Icon name="lock" class="size-4 shrink-0" /> {l.title[lang]}</li>
										),
									)}
								</ul>
							</details>
						))
					}
				</nav>
			</div>
		</aside>

		<article class="min-w-0 flex-1 py-24 sm:py-32">
			<details class="mb-10 border-y border-line lg:hidden">
				<summary class="flex cursor-pointer list-none items-center justify-between py-4 text-sm font-medium text-ink">{t.showLessons}: {course.title[lang]} <Icon name="chevron" class="size-4" /></summary>
				<ul class="pb-4 text-sm">
					{course.lessons.map((l) => l.slug ? <li><a href={lessonHref(course, l, lang)} class:list={['block py-1.5', l === lesson ? 'font-medium text-ink' : 'text-gray-500']}>{l.title[lang]}</a></li> : <li class="py-1.5 text-gray-400">{l.title[lang]}</li>)}
				</ul>
			</details>

			<div class="mx-auto max-w-[40rem]">
				<header class="mb-24 text-center">
					<p class="text-sm text-gray-500"><a href={courseHref(course, lang)} class="hover:text-ink">{t.course} {course.number} · {course.title[lang]}</a> · {lesson.kind === 'project' ? t.project : t.lesson} {index + 1}</p>
					<h1 class="mt-3 text-4xl font-medium tracking-tight text-ink">{entry.data.title}</h1>
				</header>
				<div class="lesson-prose prose prose-gray"><Content /></div>
			<div class="mt-24 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-10" data-lesson-here={key}>
				{prev ? <Btn href={lessonHref(prev.course, prev.lesson, lang)} label={t.prev} kind="outline" arrow="left" /> : <span />}
				<Btn label={t.markComplete} data-mark-complete={key} data-mark={t.markComplete} data-completed={`✓ ${t.completed}`} />
				{next ? <Btn href={lessonHref(next.course, next.lesson, lang)} label={t.next} kind="outline" arrow="right" /> : <span />}
				</div>
			</div>
		</article>

		<aside class="hidden w-52 shrink-0 py-24 sm:py-32 xl:block">
			{
				contents.length > 0 && (
					<div class="sticky top-24">
						<p class="text-sm font-medium text-ink">{t.lessonContents}</p>
						<ul class="mt-4 space-y-3 text-sm">
							{contents.map((h) => <li><a href={`#${h.slug}`} class="block text-gray-500 hover:text-ink">{h.text}</a></li>)}
						</ul>
					</div>
				)
			}
		</aside>
	</div>
	<script>
		import { setLast } from '~/components/nav/progress';
		const here = document.querySelector<HTMLElement>('[data-lesson-here]');
		if (here?.dataset.lessonHere) setLast(here.dataset.lessonHere);
	</script>
</Base>
