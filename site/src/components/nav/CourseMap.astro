---
// The whole program as a numbered path: levels, then course cards in order, with progress.
import { available, courseHref, isOpen, langOf, lessonHref, lessonKey, program, ui } from '~/data/program';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
---
<div class="ha-map not-content">
	{
		program.map((level) => (
			<section class="ha-level">
				<p class="ha-level-label">
					{t.level} {level.number} · {level.title[lang]}
				</p>
				<ol class="ha-cards">
					{level.courses.map((course) => {
						const open = isOpen(course);
						const lessons = available(course);
						const keys = lessons.map((l) => lessonKey(course, l)).join(' ');
						return (
							<li class:list={['ha-card', { 'is-soon': !open }]} data-progress-keys={open ? keys : undefined}>
								<span class="ha-card-num">{course.number}</span>
								<div class="ha-card-body">
									<p class="ha-card-kicker">
										{t.course} {course.number}
										{open ? ` · ${course.lessons.length} ${t.lessons} · ${course.hours} ${t.hours}` : ''}
									</p>
									<h3 class="ha-card-title">
										{open ? <a href={courseHref(course, lang)}>{course.title[lang]}</a> : course.title[lang]}
									</h3>
									<p class="ha-card-ship">
										<strong>{t.youShip}:</strong> {course.ship[lang]}
									</p>
									{open && (
										<div class="ha-card-foot">
											<div class="ha-bar" aria-hidden="true">
												<div class="ha-bar-fill" />
											</div>
											<a
												class="ha-btn primary"
												href={lessonHref(course, lessons[0], lang)}
												data-cta-keys={keys}
												data-hrefs={JSON.stringify(lessons.map((l) => lessonHref(course, l, lang)))}
												data-start={t.start}
												data-continue={t.continue}
												data-review={t.review}
											>
												<span data-cta-label>{t.start}</span> →
											</a>
										</div>
									)}
									{!open && <span class="ha-soon">{t.comingSoon}</span>}
								</div>
							</li>
						);
					})}
				</ol>
			</section>
		))
	}
	<p class="ha-note">{t.progressNote}</p>
</div>
<script>
	import { init } from './progress';
	init();
</script>
