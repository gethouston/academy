---
// Home page: "pick up where you left off", or "start here" for a first visit.
import { allLessons, courses, langOf, lessonHref, lessonKey, ui } from '~/data/program';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const lessons = Object.fromEntries(
	allLessons.map(({ course, lesson }) => [
		lessonKey(course, lesson),
		{ href: lessonHref(course, lesson, lang), label: `${t.course} ${course.number} · ${lesson.title[lang]}` },
	]),
);
const first = courses[0];
const firstLesson = first.lessons[0];
---
<div class="ha-continue not-content" data-continue data-lessons={JSON.stringify(lessons)} data-continue-title={t.continueTitle}>
	<p class="ha-card-kicker" data-continue-title>{t.startTitle}</p>
	<a class="ha-btn primary" href={lessonHref(first, firstLesson, lang)}>
		<span data-continue-label>{t.course} {first.number} · {firstLesson.title[lang]}</span> →
	</a>
</div>
<script>
	import { init } from './progress';
	init();
</script>
