---
// A course page: what you'll ship, progress, and every lesson in order with its status.
import { available, courseHref, courses, isOpen, langOf, lessonHref, lessonKey, locate, program, ui } from '~/data/program';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const here = locate(Astro.locals.starlightRoute.id);
if (!here) throw new Error(`CourseOutline used outside a course: ${Astro.locals.starlightRoute.id}`);
const { course } = here;
const level = program.find((l) => l.courses.includes(course));
const lessons = available(course);
const keys = lessons.map((l) => lessonKey(course, l)).join(' ');
const next = courses.slice(courses.indexOf(course) + 1).find(isOpen);
---
<div class="ha-outline not-content">
	<div class="ha-outline-head" data-progress-keys={keys} data-done-label={t.done}>
		<p class="ha-card-kicker">
			{t.level} {level?.number} · {level?.title[lang]} · {course.lessons.length} {t.lessons} · {course.hours} {t.hours}
		</p>
		<p class="ha-card-ship"><strong>{t.youShip}:</strong> {course.ship[lang]}</p>
		<div class="ha-card-foot">
			<div class="ha-bar" aria-hidden="true"><div class="ha-bar-fill" /></div>
			<span class="ha-progress-text" data-progress-text></span>
			<a
				class="ha-btn primary"
				href={lessonHref(course, lessons[0], lang)}
				data-cta-keys={keys}
				data-hrefs={JSON.stringify(lessons.map((l) => lessonHref(course, l, lang)))}
				data-start={t.start}
				data-continue={t.continue}
				data-review={t.review}
			>
				<span data-cta-label>{t.start}</span> →
			</a>
		</div>
	</div>
	<ol class="ha-lessons">
		{
			course.lessons.map((lesson, i) => (
				<li class:list={['ha-lesson', { 'is-soon': !lesson.slug }]} data-lesson-key={lesson.slug ? lessonKey(course, lesson) : undefined}>
					<span class="ha-check" aria-hidden="true">{i + 1}</span>
					<div>
						<p class="ha-lesson-kicker">
							{lesson.kind === 'project' ? t.project : t.lesson} {i + 1}
							{lesson.minutes ? ` · ${lesson.minutes} ${t.minutes}` : ''}
						</p>
						{lesson.slug ? (
							<a class="ha-lesson-title" href={lessonHref(course, lesson, lang)}>{lesson.title[lang]}</a>
						) : (
							<span class="ha-lesson-title">
								{lesson.title[lang]} <span class="ha-soon">{t.comingSoon}</span>
							</span>
						)}
					</div>
				</li>
			))
		}
	</ol>
	{next && (
		<p class="ha-next-course">
			{t.nextCourse}: <a href={courseHref(next, lang)}>{t.course} {next.number} · {next.title[lang]} →</a>
		</p>
	)}
</div>
<script>
	import { init } from './progress';
	init();
</script>
