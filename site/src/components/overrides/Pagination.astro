---
// The end of a lesson: mark it complete, then go on. Next and previous follow the program
// order, across courses, skipping lessons that aren't written yet.
import { allLessons, courseHref, langOf, lessonHref, lessonKey, locate, ui } from '~/data/program';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const here = locate(Astro.locals.starlightRoute.id);
const at = here?.lesson ? allLessons.findIndex((x) => x.course === here.course && x.lesson === here.lesson) : -1;
const prev = at > 0 ? allLessons[at - 1] : undefined;
const next = at >= 0 ? allLessons[at + 1] : undefined;
const key = here?.lesson ? lessonKey(here.course, here.lesson) : '';
---
{
	here?.lesson && (
		<div class="ha-lesson-end not-content" data-lesson-here={key}>
			<button type="button" class="ha-btn ha-complete" data-mark-complete={key} data-mark={t.markComplete} data-completed={t.completed}>
				{t.markComplete}
			</button>
			<div class="ha-pager">
				{prev ? (
					<a class="ha-pager-link" href={lessonHref(prev.course, prev.lesson, lang)} rel="prev">
						<span class="ha-pager-dir">← {t.prev}</span>
						<span class="ha-pager-title">{prev.lesson.title[lang]}</span>
					</a>
				) : (
					<span />
				)}
				{next && (
					<a class="ha-pager-link next" href={lessonHref(next.course, next.lesson, lang)} rel="next">
						<span class="ha-pager-dir">{next.course === here.course ? t.next : `${t.nextCourse}: ${t.course} ${next.course.number}`} →</span>
						<span class="ha-pager-title">{next.lesson.title[lang]}</span>
					</a>
				)}
			</div>
			<a class="ha-back" href={courseHref(here.course, lang)}>
				↑ {t.backToCourse}: {t.course} {here.course.number} · {here.course.title[lang]}
			</a>
		</div>
	)
}
<script>
	import { init, setLast } from '../nav/progress';
	const here = document.querySelector<HTMLElement>('[data-lesson-here]');
	if (here?.dataset.lessonHere) setLast(here.dataset.lessonHere);
	init();
</script>
