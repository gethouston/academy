---
// A prompt the learner copies into Claude. Put the prompt text as the slot.
import Btn from "./site/Btn";
import { langOf, ui } from "./ui";

const t = ui[langOf(Astro.currentLocale)];
const { label } = Astro.props as { label?: string };
---
<div class="ha-prompt not-prose">
	<div class="ha-prompt-head">
		<span>{label ?? t.prompt}</span>
		<Btn label={t.copy} kind="outline" data-copy data-copied={t.copied} />
	</div>
	<div class="ha-prompt-text" data-prompt><slot /></div>
</div>
<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
		if (b.dataset.ready) return;
		b.dataset.ready = '1';
		const label = b.querySelector('[data-label]');
		const original = label?.textContent ?? '';
		b.addEventListener('click', async () => {
			const text = b.closest('.ha-prompt')?.querySelector('[data-prompt]')?.textContent?.trim() ?? '';
			try {
				await navigator.clipboard.writeText(text);
				if (label) label.textContent = b.dataset.copied ?? original;
				setTimeout(() => {
					if (label) label.textContent = original;
				}, 1500);
			} catch {
				/* clipboard blocked: the text is still selectable */
			}
		});
	});
</script>
