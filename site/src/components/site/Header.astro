---
import { langOf, prefixOf, ui } from '~/data/program';
import Icon from './Icon.astro';
const { overlay = false } = Astro.props as { overlay?: boolean };
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const base = prefixOf(lang);
const path = Astro.url.pathname;
const otherPath = lang === 'es' ? path.replace(/^\/es(\/|$)/, '/') : `/es${path}`;
const links = [
	{ href: `${base}/curriculum/`, label: t.curriculum },
	{ href: `${base}/how-it-works/`, label: t.howItWorks },
	{ href: `${base}/glossary/`, label: t.glossary },
];
---
<header class:list={['site-nav top-0 right-0 left-0 z-30', overlay ? 'fixed' : 'sticky']} data-overlay={overlay ? '' : undefined}>
	<div class="flex h-[72px] items-center justify-between px-5 lg:px-10">
		<a href={`${base}/`} class="brand text-[22px] font-medium tracking-[-0.01em]">Houston <span class="font-[340]">Academy</span></a>
		<nav class="hidden items-center gap-8 text-[15px] md:flex">
			{links.map((l) => <a href={l.href} class="nav-link" aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
		</nav>
		<div class="hidden items-center gap-5 text-[15px] md:flex">
			<a href="https://github.com/gethouston/academy" class="nav-link" aria-label="GitHub"><Icon name="github" class="size-5" /></a>
			<a href="https://x.com/ja818_" class="nav-link" aria-label="X: @ja818_"><Icon name="x" class="size-[18px]" /></a>
			<a href={otherPath} class="nav-link" lang={t.languageHref}>{t.language}</a>
			<a href={`${base}/courses/hello-internet/`} class="btn btn-sm cta">{t.getStarted}</a>
		</div>
		<details class="relative md:hidden">
			<summary class="list-none rounded-full p-2" aria-label="Menu"><Icon name="menu" class="size-6" /></summary>
			<div class="absolute right-0 mt-2 w-60 rounded-2xl bg-white p-2 text-[#1a1a1a] shadow-xl ring-1 ring-black/10">
				{links.map((l) => <a href={l.href} class="block rounded-xl px-3 py-2.5 text-[15px] hover:bg-gray-50">{l.label}</a>)}
				<a href={otherPath} class="block rounded-xl px-3 py-2.5 text-[15px] hover:bg-gray-50" lang={t.languageHref}>{t.language}</a>
				<a href="https://x.com/ja818_" class="block rounded-xl px-3 py-2.5 text-[15px] hover:bg-gray-50">X: @ja818_</a>
				<a href={`${base}/courses/hello-internet/`} class="btn btn-sm btn-primary mt-1 w-full">{t.getStarted}</a>
			</div>
		</details>
	</div>
</header>
{
	overlay && (
		<script>
			const nav = document.querySelector('.site-nav');
			const hero = document.querySelector('.hero');
			const update = () => nav?.classList.toggle('scrolled', window.scrollY > (hero?.clientHeight ?? 0) - 72);
			window.addEventListener('scroll', update, { passive: true });
			update();
		</script>
	)
}
