---
import { langOf, prefixOf, ui } from '~/data/program';
import Btn from './Btn';
import Icon from './Icon.astro';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const base = prefixOf(lang);
const path = Astro.url.pathname;
const otherPath = lang === 'es' ? path.replace(/^\/es(\/|$)/, '/') : `/es${path}`;
const links = [
	{ href: `${base}/curriculum/`, label: t.curriculum },
	{ href: `${base}/how-it-works/`, label: t.howItWorks },
	{ href: `${base}/glossary/`, label: t.glossary },
];
---
<header class="sticky top-0 z-30 bg-white/90 backdrop-blur">
	<div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-10">
		<a href={`${base}/`} class="flex items-center gap-2.5">
			<span class="text-[15px] font-semibold tracking-tight text-ink">Houston Academy</span>
		</a>
		<nav class="hidden items-center gap-8 text-sm text-gray-500 md:flex">
			{links.map((l) => <a href={l.href} class:list={['hover:text-gray-900', { 'text-gray-900 font-medium': path.startsWith(l.href) }]}>{l.label}</a>)}
			<a href={otherPath} class="flex items-center gap-1 hover:text-gray-900" lang={t.languageHref}><Icon name="globe" class="size-4" />{t.language}</a>
			<a href="https://x.com/ja818_" class="hover:text-gray-900" aria-label="X: @ja818_"><Icon name="x" class="size-4" /></a>
			<Btn href={`${base}/courses/hello-internet/`} label={t.getStarted} />
		</nav>
		<details class="relative md:hidden">
			<summary class="list-none rounded-md p-2 text-gray-700 hover:bg-gray-100" aria-label="Menu"><Icon name="menu" class="size-6" /></summary>
			<div class="absolute right-0 mt-2 w-60 rounded-2xl border border-line bg-white p-2">
				{links.map((l) => <a href={l.href} class="block rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">{l.label}</a>)}
				<a href={otherPath} class="block rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" lang={t.languageHref}>{t.language}</a>
				<a href="https://x.com/ja818_" class="block rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">X: @ja818_</a>
				<div class="mt-2 grid"><Btn href={`${base}/courses/hello-internet/`} label={t.getStarted} /></div>
			</div>
		</details>
	</div>
</header>
