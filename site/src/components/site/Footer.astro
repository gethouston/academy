---
import { creator, langOf, prefixOf, ui } from '~/data/program';
import Icon from './Icon.astro';
const lang = langOf(Astro.currentLocale);
const t = ui[lang];
const base = prefixOf(lang);
const columns = [
	{
		title: t.footer.academy,
		links: [
			{ href: `${base}/curriculum/`, label: t.curriculum },
			{ href: `${base}/how-it-works/`, label: t.howItWorks },
			{ href: `${base}/glossary/`, label: t.glossary },
		],
	},
	{
		title: t.footer.houston,
		links: [
			{ href: 'https://gethouston.ai', label: 'gethouston.ai' },
			{ href: 'https://github.com/gethouston/academy', label: 'GitHub' },
		],
	},
	{
		title: t.footer.follow,
		links: [{ href: creator.url, label: `X: ${creator.handle}` }],
	},
];
---
<footer class="bg-band text-[#faf9f5]/60">
	<div class="mx-auto max-w-[1120px] px-5 pt-14 pb-10 lg:px-[52px]">
		<div class="grid gap-10 md:grid-cols-5">
			<div class="md:col-span-2">
				<a href={`${base}/`} class="text-[22px] font-medium tracking-[-0.01em] text-white">Houston <span class="font-[340]">Academy</span></a>
				<p class="mt-3 max-w-xs text-sm leading-6">{t.footer.tagline}</p>
				<div class="mt-5 flex gap-4">
					<a href={creator.url} class="hover:text-white" aria-label="X"><Icon name="x" class="size-[18px]" /></a>
					<a href="https://github.com/gethouston/academy" class="hover:text-white" aria-label="GitHub"><Icon name="github" /></a>
				</div>
			</div>
			{
				columns.map((col) => (
					<div>
						<p class="text-xs font-medium">{col.title}</p>
						<ul class="mt-4 space-y-3 text-sm">
							{col.links.map((l) => <li><a href={l.href} class="text-[#faf9f5]/85 hover:text-white">{l.label}</a></li>)}
						</ul>
					</div>
				))
			}
		</div>
		<div class="mt-12 flex flex-col gap-2 border-t border-[#faf9f5]/15 pt-6 text-xs sm:flex-row sm:justify-between">
			<p>© 2026 Houston Academy · CC BY-SA 4.0 (content) · MIT (code)</p>
			<p>{t.createdBy} <a href={creator.url} class="text-[#faf9f5]/85 hover:text-white">{creator.name} ({creator.handle})</a></p>
		</div>
	</div>
</footer>
