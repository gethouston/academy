---
// A course number in a thin circle.
const { number, soon = false, size = 'md' } = Astro.props as { number: number; soon?: boolean; size?: 'md' | 'lg' };
const box = size === 'lg' ? 'size-20 text-2xl' : 'size-12 text-base';
---
<span class:list={['grid shrink-0 place-items-center rounded-full font-medium ring-1', box, soon ? 'text-gray-400 ring-line' : 'text-ink ring-gray-300']}>{number}</span>
