---
// A course badge: the course number in an ink circle.
const { number, soon = false, size = 'md' } = Astro.props as { number: number; soon?: boolean; size?: 'md' | 'lg' };
const box = size === 'lg' ? 'size-20 text-3xl' : 'size-14 text-xl';
---
<span class:list={['grid shrink-0 place-items-center rounded-full font-[340]', box, soon ? 'bg-gray-50 text-gray-400 ring-1 ring-black/10' : 'bg-ink-strong text-white']}>{number}</span>
